{
  "services": {
    "web": {
      "root": "web/",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "PORTFOY_API_URL" }
      ]
    },
    "api": {
      "root": ".",
      "entrypoint": "api/index.py:app"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
